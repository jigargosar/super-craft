{
  "name": "super-craft",
  "version": "0.0.0",
  "description": "Ambitious Project",
  "keywords": [],
  "homepage": "https://github.com/jigargosar/super-craft#readme",
  "bugs": {
    "url": "https://github.com/jigargosar/super-craft/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jigargosar/super-craft.git"
  },
  "license": "MIT",
  "author": "Jigar Gosar",
  "scripts": {
    "postinstall": "npm install --prefix three-001 && npm install --prefix babylon-001",
    "dev": "concurrently -n tre,bab -c green,blue \"npm:dev:tre\" \"npm:dev:bab\"",
    "dev:tre": "npm run dev --prefix three-001",
    "dev:bab": "npm run dev --prefix babylon-001",
    "build": "npm run build:tre && npm run build:bab",
    "build:tre": "npm run build --prefix three-001",
    "build:bab": "npm run build --prefix babylon-001"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "trailingComma": "all",
    "endOfLine": "lf"
  },
  "dependencies": {
    "prettier": "^3.9.10"
  },
  "devDependencies": {
    "concurrently": "10.0.6"
  }
}
